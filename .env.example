# Backend service URLs (server-side only, used by Next.js rewrites)
# For local development: use localhost
# For Docker: use Docker service names (set via build args in docker-compose)
NEXT_PUBLIC_USER_API_URL=http://localhost:8081
NEXT_PUBLIC_ACCOUNT_API_URL=http://localhost:8082
NEXT_PUBLIC_TRANSACTION_API_URL=http://localhost:8083
